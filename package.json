{
  "name": "afghan-wholesale-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @afghan-wholesale/frontend",
    "dev:backend": "npm run dev --workspace @afghan-wholesale/backend",
    "build": "npm run build --workspace @afghan-wholesale/frontend",
    "test": "npm run test --workspace @afghan-wholesale/frontend && npm run test --workspace @afghan-wholesale/backend",
    "start:backend": "npm run start --workspace @afghan-wholesale/backend",
    "db:migrate": "node scripts/migrate.mjs"
  }
}
